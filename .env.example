# Obligatoire : token du bot (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Optionnel
# Langue des libellés du message privé (fr, en, ...)
UI_LOCALE=fr
# Délai minimum entre deux traductions pour un même utilisateur (ms)
COOLDOWN_MS=1500
# Retire automatiquement la réaction-drapeau (nécessite « Gérer les messages »)
REMOVE_REACTION=true
